# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
PRODUCTION=0
SESSION_COOKIE_SECURE=0

# Optional: set a strong code only if you want to enable web-based admin signup.
# Otherwise create the first admin using: python backend/create_admin.py
ADMIN_REGISTRATION_CODE=

# Optional: for multi-worker production, use a Redis URL instead of memory://
RATELIMIT_STORAGE_URI=memory://

# Optional: point this to a persistent disk path on your hosting provider.
# PHISHGUARD_DB_PATH=/var/data/phishguard.db

# Optional SMTP settings for password-reset emails (configure before production use).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=PhishGuard <no-reply@example.com>
# SMTP_USE_SSL=0
